# ClickHouse Cloud -> your service -> Connect -> HTTPS
CLICKHOUSE_HOST=xxxxxxxx.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=aegis

# MongoDB (Atlas: Connect -> Drivers -> copy the connection string). Stores raw log documents.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aegis
